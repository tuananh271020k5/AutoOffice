# ============================================================================
# Cấu hình mặc định cho AutoOffice (khi build hoặc chạy dev)
# Người dùng cuối mở Word/Excel/PowerPoint lên là có thể chat ngay lập tức
# mà không cần mở phần Cài đặt (Settings).
# ============================================================================

# Ngôn ngữ mặc định của giao diện & AI ('vi' | 'en' | 'he')
VITE_DEFAULT_LOCALE=vi

# Tự động thực thi code chỉnh sửa tài liệu mà không hỏi nút Duyệt (true | false)
VITE_AUTO_APPROVE=true

# Nhà cung cấp AI mặc định:
# Một trong các giá trị: google | openai | anthropic | openrouter | deepseek | groq | xai | ollama | lmstudio | openai-compatible
VITE_DEFAULT_PROVIDER=google

# Tên Model mặc định tương ứng với Provider trên:
# Ví dụ Google: gemini-2.5-flash | gemini-2.5-pro
# Ví dụ OpenAI: gpt-4o | gpt-4o-mini
# Ví dụ Anthropic: claude-sonnet-4-6
VITE_DEFAULT_MODEL=gemini-2.5-flash

# API Key mặc định cho Provider được chọn ở trên:
VITE_DEFAULT_API_KEY=

# Base URL mặc định (chỉ cần khi dùng openai-compatible, ollama, lmstudio, hoặc proxy riêng):
VITE_DEFAULT_BASE_URL=

# (Tùy chọn) Gắn sẵn API Key riêng cho từng nhà cung cấp:
VITE_GOOGLE_API_KEY=
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_GROQ_API_KEY=

# ============================================================================
# Cấu hình URL khi đóng gói bản Production & Bộ cài đặt AutoOffice-Setup.exe
# (Ví dụ: https://<username>.github.io/autoOffice/ hoặc https://autooffice.ten-mien-cua-ban.com/)
# ============================================================================
VITE_PUBLIC_URL=https://sivan22.github.io/autoOffice/

